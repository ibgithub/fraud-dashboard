# ==============================================================================
# Konfigurasi Database PostgreSQL (Host / VPS / Laptop / Cloud)
# Copy ke .env dan isi dengan nilai asli. JANGAN commit file .env.
# ==============================================================================
# 1. Database Autentikasi & Sistem (auth-service)
DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=anvaia
DB_USER=your-db-user
DB_PASSWORD=change-me
DB_EXTERNAL_PORT=5433

# 2. Database Analitik & ODS Data Server (executive-service)
EXEC_DB_HOST=your-exec-db-host
EXEC_DB_PORT=5432
EXEC_DB_NAME=altair_demo
EXEC_DB_USER=your-exec-db-user
EXEC_DB_PASSWORD=change-me

# ==============================================================================
# Konfigurasi Port Layanan di Host VPS
# ==============================================================================
APP_PORT=3000
AUTH_PORT=8091
EXECUTIVE_PORT=8092

# ==============================================================================
# Security, Domain & JWT
# ==============================================================================
# JWT_SECRET WAJIB diisi dengan string acak kuat (>= 32 byte / 256-bit).
# Contoh generate: openssl rand -base64 48
JWT_SECRET=generate-a-strong-random-secret-min-32-bytes
JWT_EXPIRATION=28800000

# Swagger hanya untuk non-produksi. Biarkan false di produksi.
SWAGGER_ENABLED=false

# Origin yang diizinkan (CORS). Isi hanya domain produksi + dev seperlunya.
CORS_ALLOWED_ORIGINS=https://your-domain.example.com,http://localhost:5173,http://localhost:3000
